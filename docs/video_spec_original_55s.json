    {
      "id": 4, "start": 15, "end": 24,
      "image": "assets/04_casa_mecedora.png",
      "motion": { "type": "zoomIn", "from": 1.0, "to": 1.15 },
      "text": [{ "value": "La herencia 'pa' después'…", "style": "title", "color": "cream", "position": "center" }],
      "voiceover": "¿Y sabe por qué pasa? Porque muchas familias dejan la herencia 'pa' después'. El abuelo muere, nadie hace la sucesión, nadie deslinda…",
      "transitionOut": "crossfade"
    },
    {
      "id": 5, "start": 24, "end": 30,
      "image": "assets/05_terreno_se_vende.png",
      "motion": { "type": "panRight", "distance": 80 },
      "text": [{ "value": "…y otro llega con papeles.", "style": "title", "color": "cream", "position": "center" }],
      "voiceover": "…y esa tierra queda servida para el que llegue con papeles.",
      "transitionOut": "wipe"
