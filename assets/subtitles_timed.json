[
 {
  "start": 0.08,
  "end": 1.6,
  "text": "En Puerto Plata…"
 },
 {
  "start": 1.6,
  "end": 4.2,
  "text": "hay familias que perdieron su tierra…"
 },
 {
  "start": 4.24,
  "end": 6.38,
  "text": "sin haber vendido nada."
 },
 {
  "start": 6.38,
  "end": 7.68,
  "text": "Herederos falsos."
 },
 {
  "start": 7.68,
  "end": 9.36,
  "text": "Deslindes irregulares."
 },
 {
  "start": 9.36,
  "end": 11.6,
  "text": "Títulos que aparecen… de la nada."
 },
 {
  "start": 11.6,
  "end": 13.44,
  "text": "Desde Punta Rucia hasta Luperón,"
 },
 {
  "start": 13.44,
  "end": 15.14,
  "text": "esto no es un rumor."
 },
 {
  "start": 15.14,
  "end": 16.54,
  "text": "Está en los tribunales."
 },
 {
  "start": 16.54,
  "end": 17.76,
  "text": "¿Y sabe por qué pasa?"
 },
 {
  "start": 17.76,
  "end": 18.88,
  "text": "Porque muchas familias"
 },
 {
  "start": 18.88,
  "end": 21.0,
  "text": "dejan la herencia… \"pa' después\"."
 },
 {
  "start": 21.0,
  "end": 22.08,
  "text": "El abuelo muere,"
 },
 {
  "start": 22.08,
  "end": 23.44,
  "text": "nadie hace la sucesión,"
 },
 {
  "start": 23.44,
  "end": 24.55,
  "text": "nadie deslinda…"
 },
 {
  "start": 24.55,
  "end": 26.0,
  "text": "y esa tierra queda servida"
 },
 {
  "start": 26.0,
  "end": 27.71,
  "text": "para el que llegue con papeles."
 },
 {
  "start": 27.71,
  "end": 29.84,
  "text": "Tres cosas que usted puede hacer hoy."
 },
 {
  "start": 29.84,
  "end": 32.0,
  "text": "Uno: verifique en el Registro de Títulos"
 },
 {
  "start": 32.0,
  "end": 34.16,
  "text": "a nombre de quién está su terreno."
 },
 {
  "start": 34.16,
  "end": 35.72,
  "text": "Dos: si hay herederos,"
 },
 {
  "start": 35.72,
  "end": 37.23,
  "text": "formalice la sucesión."
 },
 {
  "start": 37.23,
  "end": 38.76,
  "text": "Tres: si va a comprar,"
 },
 {
  "start": 38.76,
  "end": 40.56,
  "text": "no compre con una simple constancia"
 },
 {
  "start": 40.56,
  "end": 41.9,
  "text": "sin revisión legal."
 },
 {
  "start": 41.9,
  "end": 43.73,
  "text": "Su tierra es su historia."
 },
 {
  "start": 43.73,
  "end": 45.27,
  "text": "No deje que otro la escriba."
 },
 {
  "start": 45.27,
  "end": 46.24,
  "text": "Sandoval Legal,"
 },
 {
  "start": 46.24,
  "end": 47.64,
  "text": "abogados en Puerto Plata."
 },
 {
  "start": 47.64,
  "end": 50.2,
  "text": "Escríbanos y revisamos su caso."
 }
]