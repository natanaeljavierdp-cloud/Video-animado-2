[
 {"scene": 1,    "start": 0.03,  "end": 1.15,  "text": "En Puerto Plata"},
 {"scene": 1,    "start": 1.49,  "end": 4.12,  "text": "hay familias que perdieron su tierra…"},
 {"scene": 1,    "start": 5.53,  "end": 6.70,  "text": "sin haber vendido nada."},
 {"scene": 2,    "start": 6.97,  "end": 7.85,  "text": "Herederos falsos."},
 {"scene": 3,    "start": 8.00,  "end": 10.03, "text": "Deslindes irregulares."},
 {"scene": 3,    "start": 11.38, "end": 12.33, "text": "Títulos que aparecen…"},
 {"scene": 3,    "start": 12.56, "end": 13.74, "text": "de la nada."},
 {"scene": 3,    "start": 13.87, "end": 15.40, "text": "Desde Punta Rucia hasta Luperón,"},
 {"scene": 3,    "start": 16.76, "end": 17.45, "text": "esto no es un rumor."},
 {"scene": 3,    "start": 17.80, "end": 21.15, "text": "Está en los tribunales."},
 {"scene": 4,    "start": 22.50, "end": 24.13, "text": "¿Y sabe por qué pasa?"},
 {"scene": 4,    "start": 24.53, "end": 25.24, "text": "Porque muchas familias"},
 {"scene": 4,    "start": 25.37, "end": 26.88, "text": "dejan la herencia… \"pa' después\"."},
 {"scene": 4,    "start": 28.25, "end": 29.61, "text": "El abuelo muere,"},
 {"scene": 4,    "start": 29.90, "end": 32.16, "text": "nadie hace la sucesión, nadie deslinda…"},
 {"scene": 5,    "start": 33.61, "end": 34.94, "text": "y esa tierra queda servida"},
 {"scene": 5,    "start": 35.23, "end": 37.54, "text": "para el que llegue con papeles."},
 {"scene": "6a", "start": 38.96, "end": 40.32, "text": "Tres cosas que usted puede hacer hoy."},
 {"scene": "6a", "start": 40.49, "end": 42.67, "text": "Uno: verifique en el Registro de Títulos"},
 {"scene": "6a", "start": 44.04, "end": 45.74, "text": "a nombre de quién está su terreno."},
 {"scene": "6b", "start": 46.13, "end": 48.00, "text": "Dos: si hay herederos,"},
 {"scene": "6b", "start": 49.47, "end": 51.07, "text": "formalice la sucesión."},
 {"scene": "6c", "start": 51.28, "end": 51.88, "text": "Tres:"},
 {"scene": "6c", "start": 52.00, "end": 53.53, "text": "si va a comprar,"},
 {"scene": "6c", "start": 54.97, "end": 57.05, "text": "no compre con una simple constancia sin revisión legal."},
 {"scene": 7,    "start": 57.28, "end": 58.32, "text": "Su tierra es su historia."},
 {"scene": 7,    "start": 58.48, "end": 60.12, "text": "No deje que otro la escriba."},
 {"scene": 8,    "start": 61.49, "end": 62.68, "text": "Sandoval Legal,"},
 {"scene": 8,    "start": 63.30, "end": 65.05, "text": "abogados en Puerto Plata."},
 {"scene": 8,    "start": 65.31, "end": 66.84, "text": "Escríbanos y revisamos su caso."}
]
