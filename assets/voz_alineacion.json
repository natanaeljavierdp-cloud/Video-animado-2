[
 {"scene": 1,    "start": 0.00,  "end": 0.88,  "text": "En Puerto Plata"},
 {"scene": 1,    "start": 1.04,  "end": 3.04,  "text": "hay familias que perdieron su tierra…"},
 {"scene": 1,    "start": 3.79,  "end": 5.64,  "text": "sin haber vendido nada."},
 {"scene": 2,    "start": 5.92,  "end": 7.12,  "text": "Herederos falsos."},
 {"scene": 2,    "start": 7.44,  "end": 9.00,  "text": "Deslindes irregulares."},
 {"scene": 3,    "start": 9.20,  "end": 10.80, "text": "Títulos que aparecen…"},
 {"scene": 3,    "start": 10.84, "end": 11.44, "text": "de la nada."},
 {"scene": 3,    "start": 11.92, "end": 14.00, "text": "Desde Punta Rucia hasta Luperón,"},
 {"scene": 3,    "start": 14.20, "end": 15.64, "text": "esto no es un rumor."},
 {"scene": 3,    "start": 16.10, "end": 17.28, "text": "Está en los tribunales."},
 {"scene": 4,    "start": 17.60, "end": 19.04, "text": "¿Y sabe por qué pasa?"},
 {"scene": 4,    "start": 19.12, "end": 20.32, "text": "Porque muchas familias"},
 {"scene": 4,    "start": 20.40, "end": 22.40, "text": "dejan la herencia… \"pa' después\"."},
 {"scene": 4,    "start": 22.80, "end": 24.00, "text": "El abuelo muere,"},
 {"scene": 4,    "start": 24.08, "end": 25.76, "text": "nadie hace la sucesión,"},
 {"scene": 4,    "start": 25.84, "end": 27.20, "text": "nadie deslinda…"},
 {"scene": 5,    "start": 27.27, "end": 28.80, "text": "y esa tierra queda servida"},
 {"scene": 5,    "start": 28.88, "end": 30.68, "text": "para el que llegue con papeles."},
 {"scene": "6a", "start": 30.96, "end": 33.40, "text": "Tres cosas que usted puede hacer hoy."},
 {"scene": "6a", "start": 33.87, "end": 36.24, "text": "Uno: verifique en el Registro de Títulos"},
 {"scene": "6a", "start": 36.32, "end": 38.44, "text": "a nombre de quién está su terreno."},
 {"scene": "6b", "start": 38.72, "end": 40.48, "text": "Dos: si hay herederos,"},
 {"scene": "6b", "start": 40.60, "end": 42.32, "text": "formalice la sucesión."},
 {"scene": "6c", "start": 42.36, "end": 44.16, "text": "Tres: si va a comprar,"},
 {"scene": "6c", "start": 44.24, "end": 46.16, "text": "no compre con una simple constancia"},
 {"scene": "6c", "start": 46.32, "end": 47.84, "text": "sin revisión legal."},
 {"scene": 7,    "start": 47.88, "end": 49.92, "text": "Su tierra es su historia."},
 {"scene": 7,    "start": 50.00, "end": 51.92, "text": "No deje que otro la escriba."},
 {"scene": 8,    "start": 51.96, "end": 53.12, "text": "Sandoval Legal,"},
 {"scene": 8,    "start": 53.20, "end": 54.88, "text": "abogados en Puerto Plata."},
 {"scene": 8,    "start": 54.92, "end": 57.12, "text": "Escríbanos y revisamos su caso."}
]
