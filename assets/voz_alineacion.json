[
 {"scene": 1,    "start": 0.08,  "end": 1.24,  "text": "En Puerto Plata…"},
 {"scene": 1,    "start": 1.44,  "end": 3.60,  "text": "hay familias que perdieron su tierra…"},
 {"scene": 1,    "start": 4.00,  "end": 5.52,  "text": "sin haber vendido nada."},
 {"scene": 2,    "start": 6.06,  "end": 7.32,  "text": "Herederos falsos."},
 {"scene": 2,    "start": 7.52,  "end": 9.00,  "text": "Deslindes irregulares."},
 {"scene": 3,    "start": 9.20,  "end": 10.72, "text": "Títulos que aparecen…"},
 {"scene": 3,    "start": 10.76, "end": 11.36, "text": "de la nada."},
 {"scene": 3,    "start": 11.84, "end": 13.76, "text": "Desde Punta Rucia hasta Luperón,"},
 {"scene": 3,    "start": 13.92, "end": 15.32, "text": "esto no es un rumor."},
 {"scene": 3,    "start": 15.78, "end": 17.04, "text": "Está en los tribunales."},
 {"scene": 4,    "start": 17.26, "end": 18.64, "text": "¿Y sabe por qué pasa?"},
 {"scene": 4,    "start": 18.72, "end": 19.76, "text": "Porque muchas familias"},
 {"scene": 4,    "start": 19.84, "end": 21.68, "text": "dejan la herencia… \"pa' después\"."},
 {"scene": 4,    "start": 22.08, "end": 23.20, "text": "El abuelo muere,"},
 {"scene": 4,    "start": 23.28, "end": 24.80, "text": "nadie hace la sucesión,"},
 {"scene": 4,    "start": 24.96, "end": 26.24, "text": "nadie deslinda…"},
 {"scene": 5,    "start": 26.31, "end": 27.68, "text": "y esa tierra queda servida"},
 {"scene": 5,    "start": 27.76, "end": 29.20, "text": "para el que llegue con papeles."},
 {"scene": "6a", "start": 29.67, "end": 31.84, "text": "Tres cosas que usted puede hacer hoy."},
 {"scene": "6a", "start": 32.43, "end": 34.72, "text": "Uno: verifique en el Registro de Títulos"},
 {"scene": "6a", "start": 34.80, "end": 36.96, "text": "a nombre de quién está su terreno."},
 {"scene": "6b", "start": 37.04, "end": 38.80, "text": "Dos: si hay herederos,"},
 {"scene": "6b", "start": 38.92, "end": 40.56, "text": "formalice la sucesión."},
 {"scene": "6c", "start": 40.67, "end": 42.32, "text": "Tres: si va a comprar,"},
 {"scene": "6c", "start": 42.40, "end": 44.16, "text": "no compre con una simple constancia"},
 {"scene": "6c", "start": 44.24, "end": 45.28, "text": "sin revisión legal."},
 {"scene": 7,    "start": 45.73, "end": 47.56, "text": "Su tierra es su historia."},
 {"scene": 7,    "start": 47.89, "end": 49.28, "text": "No deje que otro la escriba."},
 {"scene": 8,    "start": 49.76, "end": 50.88, "text": "Sandoval Legal,"},
 {"scene": 8,    "start": 50.96, "end": 52.56, "text": "abogados en Puerto Plata."},
 {"scene": 8,    "start": 52.60, "end": 54.72, "text": "Escríbanos y revisamos su caso."}
]
