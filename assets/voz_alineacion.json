[
 {"scene": 1,    "start": 0.08,  "end": 1.52,  "text": "En Puerto Plata…"},
 {"scene": 1,    "start": 1.60,  "end": 3.92,  "text": "hay familias que perdieron su tierra…"},
 {"scene": 1,    "start": 4.05,  "end": 5.56,  "text": "sin haber vendido nada."},
 {"scene": 2,    "start": 5.90,  "end": 7.28,  "text": "Herederos falsos."},
 {"scene": 2,    "start": 7.40,  "end": 8.96,  "text": "Deslindes irregulares."},
 {"scene": 3,    "start": 9.01,  "end": 10.32, "text": "Títulos que aparecen…"},
 {"scene": 3,    "start": 10.36, "end": 11.28, "text": "de la nada."},
 {"scene": 3,    "start": 11.40, "end": 13.20, "text": "Desde Punta Rucia hasta Luperón,"},
 {"scene": 3,    "start": 13.40, "end": 14.88, "text": "esto no es un rumor."},
 {"scene": 3,    "start": 15.15, "end": 16.32, "text": "Está en los tribunales."},
 {"scene": 4,    "start": 16.54, "end": 17.76, "text": "¿Y sabe por qué pasa?"},
 {"scene": 4,    "start": 17.84, "end": 18.88, "text": "Porque muchas familias"},
 {"scene": 4,    "start": 18.96, "end": 21.04, "text": "dejan la herencia… \"pa' después\"."},
 {"scene": 4,    "start": 21.08, "end": 22.08, "text": "El abuelo muere,"},
 {"scene": 4,    "start": 22.16, "end": 23.60, "text": "nadie hace la sucesión,"},
 {"scene": 4,    "start": 23.68, "end": 24.80, "text": "nadie deslinda…"},
 {"scene": 5,    "start": 24.87, "end": 26.24, "text": "y esa tierra queda servida"},
 {"scene": 5,    "start": 26.32, "end": 27.84, "text": "para el que llegue con papeles."},
 {"scene": "6a", "start": 28.17, "end": 30.36, "text": "Tres cosas que usted puede hacer hoy."},
 {"scene": "6a", "start": 30.64, "end": 32.88, "text": "Uno: verifique en el Registro de Títulos"},
 {"scene": "6a", "start": 32.96, "end": 35.04, "text": "a nombre de quién está su terreno."},
 {"scene": "6b", "start": 35.20, "end": 36.64, "text": "Dos: si hay herederos,"},
 {"scene": "6b", "start": 36.76, "end": 38.32, "text": "formalice la sucesión."},
 {"scene": "6c", "start": 38.43, "end": 40.00, "text": "Tres: si va a comprar,"},
 {"scene": "6c", "start": 40.04, "end": 41.84, "text": "no compre con una simple constancia"},
 {"scene": "6c", "start": 41.92, "end": 43.04, "text": "sin revisión legal."},
 {"scene": 7,    "start": 43.27, "end": 45.04, "text": "Su tierra es su historia."},
 {"scene": 7,    "start": 45.12, "end": 46.80, "text": "No deje que otro la escriba."},
 {"scene": 8,    "start": 46.87, "end": 47.84, "text": "Sandoval Legal,"},
 {"scene": 8,    "start": 47.92, "end": 49.44, "text": "abogados en Puerto Plata."},
 {"scene": 8,    "start": 49.48, "end": 51.36, "text": "Escríbanos y revisamos su caso."}
]
