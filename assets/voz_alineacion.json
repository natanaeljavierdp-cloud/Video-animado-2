[
 {"scene": 1,    "start": 0.08,  "end": 1.52,  "text": "En Puerto Plata…"},
 {"scene": 1,    "start": 1.60,  "end": 3.60,  "text": "hay familias que perdieron su tierra…"},
 {"scene": 1,    "start": 4.24,  "end": 5.84,  "text": "sin haber vendido nada."},
 {"scene": 2,    "start": 6.38,  "end": 7.44,  "text": "Herederos falsos."},
 {"scene": 2,    "start": 7.68,  "end": 9.20,  "text": "Deslindes irregulares."},
 {"scene": 3,    "start": 9.36,  "end": 10.72, "text": "Títulos que aparecen…"},
 {"scene": 3,    "start": 10.76, "end": 11.28, "text": "de la nada."},
 {"scene": 3,    "start": 11.60, "end": 13.28, "text": "Desde Punta Rucia hasta Luperón,"},
 {"scene": 3,    "start": 13.44, "end": 14.72, "text": "esto no es un rumor."},
 {"scene": 3,    "start": 15.14, "end": 16.32, "text": "Está en los tribunales."},
 {"scene": 4,    "start": 16.54, "end": 17.68, "text": "¿Y sabe por qué pasa?"},
 {"scene": 4,    "start": 17.76, "end": 18.80, "text": "Porque muchas familias"},
 {"scene": 4,    "start": 18.88, "end": 20.96, "text": "dejan la herencia… \"pa' después\"."},
 {"scene": 4,    "start": 21.00, "end": 22.00, "text": "El abuelo muere,"},
 {"scene": 4,    "start": 22.08, "end": 23.36, "text": "nadie hace la sucesión,"},
 {"scene": 4,    "start": 23.44, "end": 24.48, "text": "nadie deslinda…"},
 {"scene": 5,    "start": 24.55, "end": 25.92, "text": "y esa tierra queda servida"},
 {"scene": 5,    "start": 26.00, "end": 27.44, "text": "para el que llegue con papeles."},
 {"scene": "6a", "start": 27.71, "end": 29.52, "text": "Tres cosas que usted puede hacer hoy."},
 {"scene": "6a", "start": 29.84, "end": 31.92, "text": "Uno: verifique en el Registro de Títulos"},
 {"scene": "6a", "start": 32.00, "end": 34.00, "text": "a nombre de quién está su terreno."},
 {"scene": "6b", "start": 34.16, "end": 35.60, "text": "Dos: si hay herederos,"},
 {"scene": "6b", "start": 35.72, "end": 37.12, "text": "formalice la sucesión."},
 {"scene": "6c", "start": 37.23, "end": 38.72, "text": "Tres: si va a comprar,"},
 {"scene": "6c", "start": 38.76, "end": 40.48, "text": "no compre con una simple constancia"},
 {"scene": "6c", "start": 40.56, "end": 41.76, "text": "sin revisión legal."},
 {"scene": 7,    "start": 41.90, "end": 43.60, "text": "Su tierra es su historia."},
 {"scene": 7,    "start": 43.73, "end": 45.20, "text": "No deje que otro la escriba."},
 {"scene": 8,    "start": 45.27, "end": 46.16, "text": "Sandoval Legal,"},
 {"scene": 8,    "start": 46.24, "end": 47.60, "text": "abogados en Puerto Plata."},
 {"scene": 8,    "start": 47.64, "end": 49.60, "text": "Escríbanos y revisamos su caso."}
]
