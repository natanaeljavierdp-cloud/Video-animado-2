[
 {"scene": 1,    "start": 0.00,  "end": 0.99,  "text": "En Puerto Plata,"},
 {"scene": 1,    "start": 1.01,  "end": 3.41,  "text": "hay familias que perdieron su tierra…"},
 {"scene": 1,    "start": 4.40,  "end": 5.94,  "text": "sin haber vendido nada."},
 {"scene": 2,    "start": 6.46,  "end": 7.87,  "text": "Herederos falsos."},
 {"scene": 2,    "start": 8.15,  "end": 9.74,  "text": "Deslindes irregulares."},
 {"scene": 3,    "start": 10.12, "end": 11.63, "text": "Títulos que aparecen…"},
 {"scene": 3,    "start": 11.81, "end": 12.64, "text": "de la nada."},
 {"scene": 3,    "start": 13.15, "end": 15.22, "text": "Desde Punta Rucia hasta Luperón,"},
 {"scene": 3,    "start": 15.34, "end": 17.10, "text": "esto no es un rumor."},
 {"scene": 3,    "start": 17.79, "end": 19.40, "text": "Está en los tribunales."},
 {"scene": 4,    "start": 19.57, "end": 21.04, "text": "¿Y sabe por qué pasa?"},
 {"scene": 4,    "start": 21.19, "end": 22.37, "text": "Porque muchas familias"},
 {"scene": 4,    "start": 22.43, "end": 24.92, "text": "dejan la herencia… \"pa' después\"."},
 {"scene": 4,    "start": 25.12, "end": 26.16, "text": "El abuelo muere,"},
 {"scene": 4,    "start": 26.33, "end": 27.92, "text": "nadie hace la sucesión,"},
 {"scene": 4,    "start": 28.13, "end": 29.52, "text": "nadie deslinda…"},
 {"scene": 5,    "start": 30.13, "end": 31.52, "text": "y esa tierra queda servida"},
 {"scene": 5,    "start": 31.58, "end": 33.23, "text": "para el que llegue con papeles."},
 {"scene": "6a", "start": 33.55, "end": 36.07, "text": "Tres cosas que usted puede hacer hoy."},
 {"scene": "6a", "start": 36.65, "end": 39.25, "text": "Uno: verifique en el Registro de Títulos"},
 {"scene": "6a", "start": 39.35, "end": 41.40, "text": "a nombre de quién está su terreno."},
 {"scene": "6b", "start": 41.84, "end": 43.75, "text": "Dos: si hay herederos,"},
 {"scene": "6b", "start": 43.83, "end": 45.49, "text": "formalice la sucesión."},
 {"scene": "6c", "start": 45.87, "end": 47.73, "text": "Tres: si va a comprar,"},
 {"scene": "6c", "start": 47.81, "end": 49.84, "text": "no compre con una simple constancia"},
 {"scene": "6c", "start": 49.89, "end": 51.26, "text": "sin revisión legal."},
 {"scene": 7,    "start": 51.54, "end": 53.36, "text": "Su tierra es su historia."},
 {"scene": 7,    "start": 54.07, "end": 56.13, "text": "No deje que otro la escriba."},
 {"scene": 8,    "start": 56.64, "end": 57.93, "text": "Sandoval Legal,"},
 {"scene": 8,    "start": 58.00, "end": 59.77, "text": "abogados en Puerto Plata."},
 {"scene": 8,    "start": 60.15, "end": 62.74, "text": "Escríbanos, y revisamos su caso."}
]
